# Choose database or memory storage.
STORAGE_BACKEND=database

# Local classroom database created by the PostgreSQL setup steps.
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/library

# Set to true to print SQLAlchemy-generated SQL in the development terminal.
DATABASE_ECHO_SQL=false

# Fixed classroom-only tokens. Replace these for a real deployment.
DEMO_MEMBER_TOKEN=member-demo-token
DEMO_ADMIN_TOKEN=admin-demo-token
